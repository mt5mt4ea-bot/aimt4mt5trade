# Web/API
HOST=0.0.0.0
PORT=1899
DATABASE_PATH=server/data/genesis_ai.db
EA_API_KEY=replace-with-a-long-random-value
ADMIN_API_TOKEN=replace-with-a-different-long-random-value
PLAN_SIGNING_SECRET=replace-with-a-third-long-random-value

# AI provider (OpenAI-compatible)
AI_PROVIDER=deepseek
AI_API_BASE=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-v4-flash
AI_TIMEOUT_SECONDS=35
ANALYSIS_INTERVAL_SECONDS=300
MIN_CONFIDENCE=0.65

# Safety: both server and EA switches must be true before an order is possible.
AUTO_TRADING_ENABLED=false
ALLOW_WEB_ENABLE=false

